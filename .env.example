# Quant_Radar configuration. Every value is optional; these are the defaults.
# Copy to .env (gitignored) and change only what you need.

# WebSocket + /health port inside the container.
RADAR_PORT=8090
# How many USDⓈ-M USDT perps to scan (top by 24h quote volume, stablecoins excluded).
RADAR_UNIVERSE=150
# Rows per side on the board.
RADAR_TOP_N=20
# A symbol is listed only at or above this 0-100 score.
RADAR_MIN_SCORE=40
# Seconds between scoring passes (aligned to the clock, +5 s).
RADAR_SCORE_INTERVAL_SECS=60
# Binance request weight this service may use per minute. The box's IP is shared
# with crypto-app's aggregator and Binance allows 2400/min per IP, so keep it at half.
RADAR_MAX_WEIGHT_1M=1200
# WebSocket clients accepted at once; further upgrades get 503.
RADAR_MAX_CLIENTS=2000

BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_FSTREAM_BASE=wss://fstream.binance.com

# 1 = run one full pass, print the board JSON to stdout and exit.
# RADAR_ONESHOT=1

RUST_LOG=info
